rules_version = '2';

// ==================================================================
// السكيما هنا مطابقة لما هو منفَّذ فعلياً بالكود (FirestoreGameRepository +
// playerMapper.ts) — انظر ملخص الفروقات عن السكيما الأصلية بالشرح المرفق.
// ==================================================================

service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isOwner(playerId) {
      return isAuthenticated() && request.auth.uid == playerId;
    }

    function currentPlayerId(gameId) {
      return get(/databases/$(database)/documents/games/$(gameId)).data.currentPlayerId;
    }

    function isCurrentPlayer(gameId) {
      return isAuthenticated() && request.auth.uid == currentPlayerId(gameId);
    }

    function isValidStatus(status) {
      return status in ['lobby', 'in-progress', 'finished'];
    }

    function isValidStatusTransition(oldStatus, newStatus) {
      return newStatus == oldStatus
        || (oldStatus == 'lobby' && newStatus == 'in-progress')
        || (oldStatus == 'in-progress' && newStatus == 'finished');
    }

    function isValidPosition(pos) {
      return pos is int && pos >= 0 && pos <= 39;
    }

    function isValidMoneyState(money, bankrupt) {
      return money is int
        && money >= -50000 && money <= 50000
        && (money < 0 ? bankrupt == true : true);
    }

    function isValidOwnedTiles(tiles) {
      return tiles is list && tiles.size() <= 28;
    }

    function isValidNickname(name) {
      return name is string && name.size() >= 1 && name.size() <= 40;
    }

    function hasOnlyAllowedPlayerFields(data) {
      return data.keys().hasOnly(
        ['nickname', 'tokenColor', 'money', 'position', 'ownedTileIds', 'isInJail', 'isBankrupt', 'buildLevels', 'jailTurnsElapsed', 'joinedAt']
      );
    }

    function isValidJailTurnsElapsed(turns) {
      return turns is int && turns >= 0 && turns <= 10;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    function isProfileOnlyUpdate() {
      return changedKeys().hasOnly(['nickname', 'tokenColor']);
    }

    function isGameplayUpdate() {
      return changedKeys().hasOnly(['money', 'position', 'ownedTileIds', 'isInJail', 'isBankrupt', 'buildLevels', 'jailTurnsElapsed']);
    }

    function isMoneyDeltaBounded(oldMoney, newMoney) {
      return (newMoney - oldMoney) <= 2000 && (oldMoney - newMoney) <= 2000;
    }

    match /games/{gameId} {
      allow read: if isAuthenticated();

      allow create: if isAuthenticated()
        && request.resource.data.keys().hasOnly(['status', 'currentPlayerId', 'turnNumber'])
        && request.resource.data.status == 'lobby'
        && request.resource.data.currentPlayerId == request.auth.uid
        && request.resource.data.turnNumber == 0;

      // --- Phase B: مزاد العقارات (activeAuction) ---
      // حقل إضافي بحت على مستند اللعبة نفسه. مسموح لأي لاعب "مؤهّل" بالمزاد يكتبه —
      // وليس فقط currentPlayerId — لأن قاعدة المزاد الرسمية تسمح لأي لاعب بالمزايدة،
      // بما فيهم من رفض الشراء أصلاً؛ لذلك هذا الفرع منفصل تماماً عن فرع تحديث
      // status/currentPlayerId/turnNumber أعلاه (الذي يبقى بصلاحية صاحب الدور فقط).
      function isValidBidAmount(amount) {
        return amount is int && amount >= 0 && amount <= 50000;
      }

      function isValidPlayerIdList(list) {
        return list is list && list.size() <= 6;
      }

      function isValidAuctionShape(auction) {
        return auction.keys().hasOnly(
          ['tileId', 'eligiblePlayerIds', 'passedPlayerIds', 'currentHighestBid', 'currentHighestBidderId', 'turnPlayerId']
        )
        && auction.tileId is int && auction.tileId >= 0 && auction.tileId <= 39
        && isValidPlayerIdList(auction.eligiblePlayerIds)
        && isValidPlayerIdList(auction.passedPlayerIds)
        && isValidBidAmount(auction.currentHighestBid)
        && (auction.currentHighestBidderId == null || auction.currentHighestBidderId is string)
        && auction.turnPlayerId is string
        && auction.turnPlayerId in auction.eligiblePlayerIds;
      }

      /**
       * الكاتب لازم يكون: (أ) بدأ المزاد بنفسه وهو صاحب الدور وقتها (بدء المزاد)،
       * أو (ب) أحد اللاعبين المؤهّلين بالمزاد الحالي أصلاً (مزايدة/تمرير) —
       * سواء كان بالمزاد المُخزَّن حالياً (resource) أو بالمزاد الجديد المرسَل.
       */
      function isEligibleAuctionWriter(auction) {
        return isAuthenticated()
          && (
            (resource.data.activeAuction == null && request.auth.uid in auction.eligiblePlayerIds)
            || (resource.data.activeAuction != null && request.auth.uid in resource.data.activeAuction.eligiblePlayerIds)
          );
      }

      allow update: if isAuthenticated()
        && (
             (
               request.auth.uid == resource.data.currentPlayerId
               && request.resource.data.keys().hasOnly(['status', 'currentPlayerId', 'turnNumber'])
               && isValidStatus(request.resource.data.status)
               && isValidStatusTransition(resource.data.status, request.resource.data.status)
               && request.resource.data.currentPlayerId is string
               && request.resource.data.turnNumber is int
               && (request.resource.data.turnNumber == resource.data.turnNumber
                   || request.resource.data.turnNumber == resource.data.turnNumber + 1)
             )
             ||
             (
               changedKeys().hasOnly(['activeAuction'])
               && (
                    request.resource.data.activeAuction == null
                    || (isValidAuctionShape(request.resource.data.activeAuction)
                        && isEligibleAuctionWriter(request.resource.data.activeAuction))
                  )
             )
           );

      allow delete: if false;

      match /players/{playerId} {
        allow read: if isAuthenticated();

        allow create: if isOwner(playerId)
          && hasOnlyAllowedPlayerFields(request.resource.data)
          && isValidNickname(request.resource.data.nickname)
          && request.resource.data.tokenColor is string
          && request.resource.data.money == 1200
          && request.resource.data.position == 0
          && isValidOwnedTiles(request.resource.data.ownedTileIds)
          && request.resource.data.ownedTileIds.size() == 0
          && request.resource.data.isInJail == false
          && request.resource.data.isBankrupt == false
          && request.resource.data.jailTurnsElapsed == 0;

        allow update: if isAuthenticated()
          && hasOnlyAllowedPlayerFields(request.resource.data)
          && request.resource.data.joinedAt == resource.data.joinedAt
          && isValidPosition(request.resource.data.position)
          && isValidMoneyState(request.resource.data.money, request.resource.data.isBankrupt)
          && isValidOwnedTiles(request.resource.data.ownedTileIds)
          && request.resource.data.isInJail is bool
          && isValidJailTurnsElapsed(request.resource.data.jailTurnsElapsed)
          && isMoneyDeltaBounded(resource.data.money, request.resource.data.money)
          && (
               (isOwner(playerId) && isProfileOnlyUpdate())
               ||
               (isCurrentPlayer(gameId) && isGameplayUpdate())
             );

        allow delete: if false;
      }

      match /properties/{propertyId} {
        allow read: if isAuthenticated();

        allow write: if isCurrentPlayer(gameId)
          && request.resource.data.keys().hasOnly(['ownerId', 'level', 'buildingType'])
          && (request.resource.data.ownerId == null || request.resource.data.ownerId is string)
          && request.resource.data.level is int
          && request.resource.data.level >= 0 && request.resource.data.level <= 5
          && request.resource.data.buildingType in ['none', 'rest-house', 'garage', 'hotel'];
      }

      match /events/{eventId} {
        allow read: if isAuthenticated();

        allow create: if isAuthenticated()
          && request.resource.data.keys().hasOnly(['type', 'playerId', 'payload', 'timestamp'])
          && request.resource.data.type is string
          && (
               request.resource.data.playerId == request.auth.uid
               // 'property-auctioned' حدث نظامي بدون فاعل واحد بالضرورة (أي عميل مؤهّل
               // قد يحسم المزاد) — playerId فارغ عمداً بهذه الحالة فقط، وليس تعميماً.
               || (request.resource.data.type == 'property-auctioned' && request.resource.data.playerId == '')
             )
          && request.resource.data.payload is map;

        allow update: if false;
        allow delete: if false;
      }
    }
  }
}